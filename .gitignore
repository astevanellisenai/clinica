# Dependências
node_modules/

# Variáveis de ambiente
# Exceção didática: o .env desta clínica contém apenas credenciais públicas de teste.
# Em qualquer ambiente real, remover a exceção abaixo e nunca versionar .env.
.env.*
!.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# VS Code
.vscode/

# Sistema operacional
.DS_Store
Thumbs.db

# Fotos de pets enviadas no uso local (não versionar dados dos alunos)
public/img/pets/*

# Apenas as imagens de demonstração devem ser versionadas
!public/img/pets/.gitkeep
!public/img/pets/sem-foto.svg
!public/img/pets/mel.jpg
!public/img/pets/luna.jpg
