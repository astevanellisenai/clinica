<%-include('../includes/header')%><h1>Agendamentos</h1><a class="btn" href="/agendamentos/novo">Novo agendamento</a><div class="card table"><table><tr><th>Data</th><th>Pet</th><th>Espécie / Raça</th><th>Tutor</th><th>E-mail / Telefone / CPF</th><th>Motivo / Situação</th><th>Ação</th></tr><%let mes='';registros.forEach(a=>{const m=new Date(a.data_agendamento).toLocaleDateString('pt-BR',{month:'long',year:'numeric'});if(m!==mes){mes=m;%><tr><th colspan="7"><%=mes%></th></tr><%}%><tr><td><%=new Date(a.data_agendamento).toLocaleString('pt-BR')%></td><td><%=a.pet_nome%></td><td><%=a.especie%> / <%=a.raca%></td><td><%=a.tutor_nome%></td><td><%=a.email%> / <%=a.telefone%> / <%=a.cpf%></td><td><%=a.descricao%> (<%=a.status%>)</td><td><a href="/agendamentos/editar/<%=a.id%>">Editar</a></td></tr><%})%></table></div><%-include('../includes/footer')%>