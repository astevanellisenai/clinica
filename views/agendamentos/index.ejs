<%-include('../includes/header')%><div class="page-heading"><div><span class="eyebrow">ATENDIMENTOS</span><h1>Agendamentos</h1><p>Consultas organizadas em cards com foto do pet.</p></div><a href="/agendamentos/novo" class="btn">＋ Novo agendamento</a></div><section class="panel"><form method="get" class="listing-filters"><label class="filter-search">Pesquisar<input name="busca" value="<%=busca%>" placeholder="Pesquisar registros"></label><label>Situação<select name="filtro"><option value="">Todas</option><option value="agendado" <%=filtro==='agendado'?'selected':''%>>Agendado</option><option value="concluido" <%=filtro==='concluido'?'selected':''%>>Concluído</option><option value="cancelado" <%=filtro==='cancelado'?'selected':''%>>Cancelado</option></select></label><label>Mês<input type="month" name="mes" value="<%=mes%>"></label><label>Ordenação<select name="ordem"><option value="data" <%=ordem==='data'?'selected':''%>>Data crescente</option><option value="data_desc" <%=ordem==='data_desc'?'selected':''%>>Data decrescente</option><option value="pet" <%=ordem==='pet'?'selected':''%>>Pet</option><option value="tutor" <%=ordem==='tutor'?'selected':''%>>Tutor</option><option value="status" <%=ordem==='status'?'selected':''%>>Situação</option></select></label><button class="btn">Filtrar</button><a class="btn btn-secondary" href="/agendamentos">Limpar</a></form><%if(!registros.length){%><div class="empty-state"><h3>Nenhum agendamento encontrado</h3><p>Altere os filtros ou cadastre uma consulta.</p></div><%}else{%><div class="schedule-grid"><%registros.forEach(a=>{%><article class="schedule-card"><div class="schedule-head"><img class="schedule-pet-photo" src="<%=a.imagem_url?'/img/pets/'+a.imagem_url:'/img/pets/sem-foto.svg'%>" alt="Foto de <%=a.pet_nome%>"><div class="schedule-name"><strong><%=a.pet_nome%></strong><small><%=a.especie%> · <%=a.raca||'Sem raça informada'%></small></div><span class="schedule-status status-<%=a.status%>"><%=a.status%></span></div><div class="schedule-details"><p><span>📅 Data e hora</span><strong><%=new Date(a.data_agendamento).toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'})%></strong></p><p><span>👤 Tutor</span><strong><%=a.tutor_nome%></strong></p><p><span>☎ Telefone</span><strong><%=a.telefone||'-'%></strong></p><p><span>📧 E-mail</span><strong><%=a.email||'-'%></strong></p><p class="full"><span>🩺 Atendimento</span><strong><%=a.descricao%></strong></p></div><div class="schedule-actions"><a class="btn btn-edit" href="/agendamentos/editar/<%=a.id%>">✎ Editar</a><form method="post" action="/agendamentos/excluir/<%=a.id%>" onsubmit="return confirm('Confirma a exclusão deste agendamento?')"><button class="btn btn-delete" type="submit">Excluir</button></form></div></article><%})%></div><%}%><%-include('../includes/paginacao')%></section><%-include('../includes/footer')%>