<%-include('../includes/header')%><div class="page-heading"><div><span class="eyebrow">ATENDIMENTOS</span><h1>Agendamentos</h1><p>Consultas por mês, data e horário.</p></div><a href="/agendamentos/novo" class="btn">＋ Novo agendamento</a></div><section class="panel"><div class="table table-scroll table-agendamentos" tabindex="0" aria-label="Tabela de agendamentos; role para os lados quando necessário"><table><thead><tr><th>Data</th><th>Pet</th><th>Espécie/Raça</th><th>Tutor</th><th>Contato / CPF</th><th>Descrição</th><th>Ações</th></tr></thead><tbody><%let mes='';registros.forEach(a=>{const m=new Date(a.data_agendamento).toLocaleDateString('pt-BR',{month:'long',year:'numeric'});if(m!==mes){mes=m;%><tr><th colspan="7"><%=mes%></th></tr><%}%><tr><td><%=new Date(a.data_agendamento).toLocaleString('pt-BR')%></td><td><%=a.pet_nome%></td><td><%=a.especie%> / <%=a.raca||'-'%></td><td><%=a.tutor_nome%></td><td><%=a.email%> / <%=a.telefone%> / <%=a.cpf%></td><td><%=a.descricao%> · <%=a.status%></td><td><div class="row-actions"><a href="/agendamentos/editar/<%=a.id%>" class="btn btn-edit">✎ Editar</a><form method="post" action="/agendamentos/excluir/<%=a.id%>" onsubmit="return confirm('Confirma a exclusão deste registro?')"><input type="hidden" name="_csrf" value="<%=csrf%>"><button type="submit" class="btn btn-delete">Excluir</button></form></div></td></tr><%})%></tbody></table></div></section><%-include('../includes/footer')%>