<%-include('../includes/header')%><h1><%=titulo%></h1><div class="card"><form method="post" action="<%=acao%>"><input type="hidden" name="_csrf" value="<%=csrf%>"><label>Pet / Tutor</label><select required name="pet_id"><option value="">Selecione</option><%pets.forEach(p=>{%><option value="<%=p.id%>" <%=Number(registro.pet_id)===p.id?'selected':''%>><%=p.nome%> — <%=p.tutor_nome%></option><%})%></select><label>Data e hora</label><input type="datetime-local" required name="data_agendamento" value="<%=registro.data_formatada||''%>"><label>Descrição</label><input required name="descricao" value="<%=registro.descricao||''%>"><label>Situação</label><select name="status"><%['agendado','concluido','cancelado'].forEach(s=>{%><option value="<%=s%>" <%=registro.status===s?'selected':''%>><%=s%></option><%})%></select><button>Salvar</button> <a href="/agendamentos">Cancelar</a></form></div><%-include('../includes/footer')%>