<%-include('../includes/header')%>
<div class="page-heading"><div><span class="eyebrow">ATENDIMENTOS</span><h1><%=titulo%></h1><p>Organize a data, o pet e a situação da consulta.</p></div></div>
<section class="panel form-panel"><form method="post" action="<%=acao%>"><input type="hidden" name="_csrf" value="<%=csrf%>">
<div class="form-grid"><div class="campo-formulario"><label for="pet_id">Pet / Tutor</label><select id="pet_id" required name="pet_id"><option value="">Selecione</option><%pets.forEach(p=>{%><option value="<%=p.id%>" <%=Number(registro.pet_id)===p.id?'selected':''%>><%=p.nome%> — <%=p.tutor_nome%></option><%})%></select></div>
<div class="campo-formulario"><label for="data_agendamento">Data e hora</label><input id="data_agendamento" type="datetime-local" required name="data_agendamento" value="<%=registro.data_formatada||''%>"></div>
<div class="campo-formulario"><label for="descricao">Descrição</label><input id="descricao" required name="descricao" value="<%=registro.descricao||''%>"></div>
<div class="campo-formulario"><label for="status">Situação</label><select id="status" name="status"><%['agendado','concluido','cancelado'].forEach(s=>{%><option value="<%=s%>" <%=registro.status===s?'selected':''%>><%=s%></option><%})%></select></div></div>
<div class="form-actions"><a href="/agendamentos" class="btn btn-secondary">Cancelar</a><button class="btn" type="submit">Salvar agendamento</button></div></form></section><%-include('../includes/footer')%>