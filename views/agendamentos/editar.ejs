<%- include('../includes/header') %>
<div class="page-heading">
    <div>
        <span class="eyebrow">CADASTROS</span>
        <h1>Editar agendamento</h1>
        <p>Organize a data, o pet e a situação da consulta.</p>
    </div>
</div>
<section class="panel form-panel">
    <form method="post" action="/agendamentos/editar/<%= agendamento.id %>">
        <div class="form-grid">
            <div class="campo-formulario">
                <label for="pet_id">Pet / Tutor</label>
                <select id="pet_id" name="pet_id" required>
                    <option value="">Selecione</option>
                    <% pets.forEach(pet => { %>
                        <option value="<%= pet.id %>" <%= Number(agendamento.pet_id) === pet.id ? 'selected' : '' %>><%= pet.nome %> — <%= pet.tutor_nome %></option>
                    <% }) %>
                </select>
            </div>
            <div class="campo-formulario">
            <label for="data_agendamento">Data e hora</label>
            <input id="data_agendamento" name="data_agendamento" type="datetime-local" required value="<%= agendamento.data_formatada %>">
        </div>
            <div class="campo-formulario">
            <label for="descricao">Descrição</label>
            <input id="descricao" name="descricao" required value="<%= agendamento.descricao %>">
        </div>
            <div class="campo-formulario">
                <label for="status">Situação</label>
                <select id="status" name="status">
                    <option value="agendado" <%= agendamento.status === 'agendado' ? 'selected' : '' %>>Agendado</option>
                    <option value="concluido" <%= agendamento.status === 'concluido' ? 'selected' : '' %>>Concluído</option>
                    <option value="cancelado" <%= agendamento.status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
                </select>
            </div>
        </div>
        <div class="form-actions">
        <a href="/agendamentos" class="btn btn-secondary">Cancelar</a>
        <button class="btn" type="submit">Salvar agendamento</button>
    </div>
    </form>
</section>
<%- include('../includes/footer') %>
