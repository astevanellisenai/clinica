<%-include('../includes/header')%><div class="page-heading"><div><span class="eyebrow">ACESSOS</span><h1><%=titulo%></h1><p>Dados do usuário e permissão de acesso.</p></div></div><section class="panel form-panel"><%if(erro){%><div class="erro"><%=erro%></div><%}%><form method="post" action="<%=acao%>"><input type="hidden" name="_csrf" value="<%=csrf%>"><div class="form-grid"><div class="campo-formulario"><label>Nome</label><input name="nome" required value="<%=registro.nome||''%>"></div><div class="campo-formulario"><label>Login</label><input type="text" name="email" required value="<%=registro.email||''%>"></div><div class="campo-formulario"><label>Senha <%=registro.id?'(em branco mantém a atual)':''%></label><input type="password" name="senha" autocomplete="new-password" <%=registro.id?'':'required'%>></div><div class="campo-formulario"><label>Situação</label><select name="situacao"><option value="1" <%=Number(registro.situacao)===1?'selected':''%>>Ativo</option><option value="0" <%=Number(registro.situacao)===0?'selected':''%>>Inativo</option></select></div></div><div class="form-actions"><a href="/usuarios" class="btn btn-secondary">Cancelar</a><button class="btn">Salvar usuário</button></div></form></section><%-include('../includes/footer')%>