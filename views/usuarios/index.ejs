<%-include('../includes/header')%><div class="page-heading"><div><span class="eyebrow">ACESSOS</span><h1>Usuários</h1><p>Controle das contas do sistema.</p></div><a href="/usuarios/novo" class="btn">＋ Novo usuário</a></div><%if(aviso){%><div class="erro"><%=aviso%></div><%}%><section class="panel"><form method="get" class="listing-filters"><label class="filter-search">Pesquisar<input name="busca" value="<%=busca%>" placeholder="Pesquisar registros"></label><label>Situação<select name="filtro"><option value="">Todas</option><option value="1" <%=filtro==='1'?'selected':''%>>Ativos</option><option value="0" <%=filtro==='0'?'selected':''%>>Inativos</option></select></label><label>Ordenação<select name="ordem"><option value="nome" <%=ordem==='nome'?'selected':''%>>Nome A-Z</option><option value="nome_desc" <%=ordem==='nome_desc'?'selected':''%>>Nome Z-A</option><option value="email" <%=ordem==='email'?'selected':''%>>Login</option><option value="id_desc" <%=ordem==='id_desc'?'selected':''%>>Mais recentes</option></select></label><button class="btn">Filtrar</button><a class="btn btn-secondary" href="/usuarios">Limpar</a></form><div class="table table-scroll table-usuarios" tabindex="0" aria-label="Tabela de usuarios; role para os lados quando necessário"><table><thead><tr><th>Nome</th><th>Login</th><th>Situação</th><th>Ações</th></tr></thead><tbody><%registros.forEach(u=>{%><tr><td><strong><%=u.nome%></strong></td><td><%=u.email%></td><td><span class="status-badge"><%=u.situacao===1?'Ativo':'Inativo'%></span></td><td><div class="row-actions"><a class="btn btn-edit" href="/usuarios/editar/<%=u.id%>">✎ Editar</a><%if(u.id!==usuario.id){%><form method="post" action="/usuarios/excluir/<%=u.id%>" onsubmit="return confirm('Excluir este usuário?')"><input type="hidden" name="_csrf" value="<%=csrf%>"><button type="submit" class="btn btn-delete">Excluir</button></form><%}else{%><small>Conta atual</small><%}%></div></td></tr><%})%></tbody></table></div><%-include('../includes/paginacao')%></section><%-include('../includes/footer')%>