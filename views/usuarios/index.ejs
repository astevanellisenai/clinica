<%-include('../includes/header')%><div class="page-heading"><div><span class="eyebrow">ACESSOS</span><h1>Usuários</h1><p>Controle das contas do sistema.</p></div><a href="/usuarios/novo" class="btn">＋ Novo usuário</a></div><%if(aviso){%><div class="erro"><%=aviso%></div><%}%><section class="panel"><div class="table table-scroll table-usuarios" tabindex="0" aria-label="Tabela de usuarios; role para os lados quando necessário"><table><thead><tr><th>Nome</th><th>Login</th><th>Situação</th><th>Ações</th></tr></thead><tbody><%registros.forEach(u=>{%><tr><td><strong><%=u.nome%></strong></td><td><%=u.email%></td><td><span class="status-badge"><%=u.situacao===1?'Ativo':'Inativo'%></span></td><td><div class="row-actions"><a class="btn btn-edit" href="/usuarios/editar/<%=u.id%>">✎ Editar</a><%if(u.id!==usuario.id){%><form method="post" action="/usuarios/excluir/<%=u.id%>" onsubmit="return confirm('Excluir este usuário?')"><input type="hidden" name="_csrf" value="<%=csrf%>"><button type="submit" class="btn btn-delete">Excluir</button></form><%}else{%><small>Conta atual</small><%}%></div></td></tr><%})%></tbody></table></div></section><%-include('../includes/footer')%>