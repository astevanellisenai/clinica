<%- include('../includes/header') %>
<div class="page-heading">
    <div>
        <span class="eyebrow">CADASTROS</span>
        <h1>Cadastrar usuário</h1>
        <p>Dados da conta e permissão de acesso.</p>
    </div>
</div>
<section class="panel form-panel">
    <% if (erro) { %>
        <div class="erro"><%= erro %></div>
    <% } %>
    <form method="post" action="/usuarios/novo">
        <div class="form-grid">
            <div class="campo-formulario">
            <label for="nome">Nome</label>
            <input id="nome" name="nome" required maxlength="120" value="<%= registro.nome || '' %>">
        </div>
            <div class="campo-formulario">
            <label for="email">Login (e-mail)</label>
            <input id="email" name="email" type="email" required maxlength="150" value="<%= registro.email || '' %>">
        </div>
            <div class="campo-formulario">
                <label for="senha">Senha </label>
                <input type="password" id="senha" name="senha" autocomplete="new-password" required>
            </div>
            <div class="campo-formulario">
                <label for="situacao">Situação</label>
                <select id="situacao" name="situacao">
                    <option value="1" <%= Number(registro.situacao) === 1 ? 'selected' : '' %>>Ativo</option>
                    <option value="0" <%= Number(registro.situacao) === 0 ? 'selected' : '' %>>Inativo</option>
                </select>
            </div>
        </div>
        <div class="form-actions">
        <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
        <button class="btn" type="submit">Salvar usuário</button>
    </div>
    </form>
</section>
<%- include('../includes/footer') %>
