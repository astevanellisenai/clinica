<div class="pagination"><p>Exibindo <strong><%=totalRegistros?((pagina-1)*limite+1):0%>–<%=Math.min(totalRegistros,pagina*limite)%></strong> de <strong><%=totalRegistros%></strong> registros</p><nav class="pagination-links" aria-label="Paginação"><%const params=new URLSearchParams({busca:busca||'',ordem:ordem||'',filtro:filtro||'',mes:mes||''});const url=n=>{const q=new URLSearchParams(params);q.set('pagina',String(n));return '?'+q.toString();};%><%if(pagina>1){%><a href="<%=url(pagina-1)%>">← Anterior</a><%}%><%for(let n=Math.max(1,pagina-2);n<=Math.min(totalPaginas,pagina+2);n++){%><a href="<%=url(n)%>" class="<%=pagina===n?'selected':''%>" <%=pagina===n?'aria-current=page':''%>><%=n%></a><%}%><%if(pagina<totalPaginas){%><a href="<%=url(pagina+1)%>">Próxima →</a><%}%></nav></div>