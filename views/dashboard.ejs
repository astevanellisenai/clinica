<%-include('includes/header')%><div class="page-heading"><div><span class="eyebrow">VISÃO GERAL</span><h1>Dashboard</h1><p>Acompanhe os principais indicadores da Clínica Vet.</p></div><a href="/agendamentos/novo" class="btn">＋ Novo agendamento</a></div>
<div class="stat-grid"><a class="stat-card lavender" href="/pets"><span>🐾</span><small>Total de pets</small><strong><%=quantidades[1]%></strong><em>Animais cadastrados ↗</em></a><a class="stat-card mint" href="/agendamentos"><span>📅</span><small>Agendamentos</small><strong><%=quantidades[2]%></strong><em>Atendimentos registrados ↗</em></a><a class="stat-card peach" href="/tutores"><span>♙</span><small>Tutores</small><strong><%=quantidades[0]%></strong><em>Responsáveis cadastrados ↗</em></a><div class="stat-card violet"><span>✓</span><small>Concluídos</small><strong><%=status.find(s=>s.status==='concluido')?.total||0%></strong><em>Atendimentos realizados</em></div></div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Próximas consultas</h2><p>Atendimentos programados</p></div><a href="/agendamentos">Ver todas →</a></div><%if(!proximos.length){%><div class="empty-state">📅<h3>Nenhum atendimento futuro</h3><p>Cadastre um novo agendamento para começar.</p></div><%}else{%><%proximos.forEach(a=>{%><div class="appointment"><img class="pet-thumb" src="<%=a.imagem_url?'/img/pets/'+a.imagem_url:'/img/pets/sem-foto.svg'%>" alt=""><div><strong><%=a.pet_nome%></strong><small>Tutor: <%=a.tutor_nome%> · <%=a.descricao%></small></div><time><%=new Date(a.data_agendamento).toLocaleString('pt-BR')%></time></div><%})%><%}%></section><aside class="panel"><div class="panel-heading"><div><h2>Resumo da agenda</h2><p>Situação dos registros</p></div></div><%status.forEach(s=>{%><div class="status-row"><span><%=s.status%></span><strong><%=s.total%></strong></div><%})%><div class="quick-actions"><h3>Acesso rápido</h3><a href="/pets/novo">＋ Cadastrar pet</a><a href="/tutores/novo">＋ Novo tutor</a><a href="/usuarios">Gerenciar usuários</a></div></aside></div><%-include('includes/footer')%>