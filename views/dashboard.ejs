<%-include('includes/header')%><div class="page-heading"><div><span class="eyebrow">VISÃO GERAL</span><h1>Dashboard</h1><p>Acompanhe os principais indicadores da Clínica Vet.</p></div><a href="/agendamentos/novo" class="btn">＋ Novo agendamento</a></div>
<div class="stat-grid"><a class="stat-card lavender" href="/pets"><span>🐾</span><small>Total de pets</small><strong><%=quantidades[1]%></strong><em>Animais cadastrados ↗</em></a><a class="stat-card mint" href="/agendamentos"><span>📅</span><small>Agendamentos</small><strong><%=quantidades[2]%></strong><em>Atendimentos registrados ↗</em></a><a class="stat-card peach" href="/tutores"><span>♙</span><small>Tutores</small><strong><%=quantidades[0]%></strong><em>Responsáveis cadastrados ↗</em></a><div class="stat-card violet"><span>✓</span><small>Usuários</small><strong><%=totalUsuarios%></strong><em>Contas cadastradas</em></div></div>
<div class="dash-charts"><section class="panel chart-panel"><div class="panel-heading"><div><h2>Atendimentos por situação</h2><p>Distribuição dos agendamentos</p></div></div><%const ag=status.find(s=>s.status==='agendado')?.total||0,co=status.find(s=>s.status==='concluido')?.total||0,ca=status.find(s=>s.status==='cancelado')?.total||0,tot=ag+co+ca;const pAg=tot?100*ag/tot:0,pCo=tot?100*co/tot:0;%><div class="donut-layout"><div class="donut-chart" style="background:conic-gradient(#7649bd 0 <%=pAg%>%,#31b78c <%=pAg%>% <%=pAg+pCo%>%,#f3a46c <%=pAg+pCo%>% 100%)"><div><strong><%=tot%></strong><small>Total</small></div></div><div class="chart-legend"><p><i style="background:#7649bd"></i>Agendados <strong><%=ag%></strong></p><p><i style="background:#31b78c"></i>Concluídos <strong><%=co%></strong></p><p><i style="background:#f3a46c"></i>Cancelados <strong><%=ca%></strong></p></div></div></section><section class="panel chart-panel"><div class="panel-heading"><div><h2>Consultas por mês</h2><p>Últimos seis meses</p></div></div><%const maior=Math.max(1,...mensal.map(x=>x.total));%><div class="month-chart"><%mensal.forEach(m=>{%><div class="month-bar"><strong><%=m.total%></strong><div class="bar-track"><div class="bar-fill" style="height:<%=m.total/maior*100%>%"></div></div><small><%=m.mes.slice(5)%>/<%=m.mes.slice(2,4)%></small></div><%})%></div></section><section class="panel chart-panel"><div class="panel-heading"><div><h2>Pets por espécie</h2><p>Distribuição dos animais</p></div></div><%const maiorEsp=Math.max(1,...especies.map(x=>x.total));%><div class="species-chart"><%if(!especies.length){%><p>Não há pets cadastrados.</p><%}%><%especies.forEach(s=>{%><div class="species-group"><div class="species-label"><span><%=s.especie%></span><strong><%=s.total%></strong></div><div class="species-track"><div style="width:<%=s.total/maiorEsp*100%>%"></div></div></div><%})%></div></section></div><div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Próximas consultas</h2><p>Atendimentos programados</p></div><a href="/agendamentos">Ver todas →</a></div><%if(!proximos.length){%><div class="empty-state">📅<h3>Nenhum atendimento futuro</h3><p>Cadastre um novo agendamento para começar.</p></div><%}else{%><%proximos.forEach(a=>{%><div class="appointment"><img class="pet-thumb" src="<%=a.imagem_url?'/img/pets/'+a.imagem_url:'/img/pets/sem-foto.svg'%>" alt=""><div><strong><%=a.pet_nome%></strong><small>Tutor: <%=a.tutor_nome%> · <%=a.descricao%></small></div><time><%=new Date(a.data_agendamento).toLocaleString('pt-BR')%></time></div><%})%><%}%></section><aside class="panel"><div class="panel-heading"><div><h2>Resumo da agenda</h2><p>Situação dos registros</p></div></div><%status.forEach(s=>{%><div class="status-row"><span><%=s.status%></span><strong><%=s.total%></strong></div><%})%><div class="quick-actions"><h3>Acesso rápido</h3><a href="/pets/novo">＋ Cadastrar pet</a><a href="/tutores/novo">＋ Novo tutor</a><a href="/usuarios">Gerenciar usuários</a></div></aside></div><%-include('includes/footer')%>