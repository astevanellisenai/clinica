<%-include('../includes/header')%>
<div class="page-heading"><div><span class="eyebrow">CADASTROS</span><h1><%=titulo%></h1><p>Informações de contato do responsável pelo pet.</p></div></div>
<section class="panel form-panel"><form method="post" action="<%=acao%>"><input type="hidden" name="_csrf" value="<%=csrf%>">
<div class="form-grid"><div class="campo-formulario"><label for="nome">Nome</label><input id="nome" required name="nome" value="<%=registro.nome||''%>"></div>
<div class="campo-formulario"><label for="email">E-mail</label><input id="email" required type="email" name="email" value="<%=registro.email||''%>"></div>
<div class="campo-formulario"><label for="telefone">Telefone</label><input id="telefone" name="telefone" value="<%=registro.telefone||''%>"></div>
<div class="campo-formulario"><label for="cpf">CPF</label><input id="cpf" required name="cpf" value="<%=registro.cpf||''%>"></div></div>
<div class="form-actions"><a href="/tutores" class="btn btn-secondary">Cancelar</a><button class="btn" type="submit">Salvar tutor</button></div></form></section><%-include('../includes/footer')%>