<%-include('../includes/header')%><h1>Tutores</h1><a class="btn" href="/tutores/novo">Novo tutor</a><form method="get"><input name="busca" placeholder="Buscar por nome ou e-mail" value="<%=busca%>"><button>Buscar</button></form><div class="card table"><table><tr><th>Nome</th><th>E-mail</th><th>Telefone</th><th>CPF</th><th>Ação</th></tr><%registros.forEach(t=>{%><tr><td><%=t.nome%></td><td><%=t.email%></td><td><%=t.telefone%></td><td><%=t.cpf%></td><td><a href="/tutores/editar/<%=t.id%>">Editar</a></td></tr><%})%></table></div><%-include('../includes/footer')%>