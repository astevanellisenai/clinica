<%-include('../includes/header')%><div class="page-heading"><div><span class="eyebrow">CADASTROS</span><h1>Tutores</h1><p>Responsáveis pelos animais cadastrados.</p></div><a href="/tutores/novo" class="btn">＋ Novo tutor</a></div><section class="panel"><form method="get" class="filter-bar"><input name="busca" placeholder="Pesquisar nome ou e-mail" value="<%=busca%>"><button class="btn">Buscar</button></form><div class="table table-scroll table-tutores" tabindex="0" aria-label="Tabela de tutores; role para os lados quando necessário"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Telefone</th><th>CPF</th><th>Ações</th></tr></thead><tbody><%registros.forEach(t=>{%><tr><td><strong><%=t.nome%></strong></td><td><%=t.email%></td><td><%=t.telefone%></td><td><%=t.cpf%></td><td><div class="row-actions"><a href="/tutores/editar/<%=t.id%>" class="btn btn-edit">✎ Editar</a><form method="post" action="/tutores/excluir/<%=t.id%>" onsubmit="return confirm('Confirma a exclusão deste registro?')"><input type="hidden" name="_csrf" value="<%=csrf%>"><button type="submit" class="btn btn-delete">Excluir</button></form></div></td></tr><%})%></tbody></table></div></section><%-include('../includes/footer')%>