<%-include('../includes/header')%><h1><%=titulo%></h1><div class="card"><form method="post" action="<%=acao%>"><input type="hidden" name="_csrf" value="<%=csrf%>"><label>Nome</label><input required name="nome" value="<%=registro.nome||''%>"><label>Espécie</label><input required name="especie" value="<%=registro.especie||''%>"><label>Raça</label><input name="raca" value="<%=registro.raca||''%>"><label>Tutor</label><select required name="tutor_id"><option value="">Selecione</option><%tutores.forEach(t=>{%><option value="<%=t.id%>" <%=Number(registro.tutor_id)===t.id?'selected':''%>><%=t.nome%></option><%})%></select><button>Salvar</button> <a href="/pets">Cancelar</a></form></div><%-include('../includes/footer')%>