<%-include('../includes/header')%><div class="page-heading"><div><span class="eyebrow">CADASTROS</span><h1>Pets</h1><p>Informações dos animais e tutores.</p></div><a href="/pets/novo" class="btn">＋ Novo pet</a></div><section class="panel"><div class="table table-scroll table-pets" tabindex="0" aria-label="Tabela de pets; role para os lados quando necessário"><table><thead><tr><th>Foto</th><th>Pet</th><th>Espécie</th><th>Raça</th><th>Tutor</th><th>Ações</th></tr></thead><tbody><%registros.forEach(p=>{%><tr><td><img class="pet-thumb" src="<%=p.imagem_url?'/img/pets/'+p.imagem_url:'/img/pets/sem-foto.svg'%>" alt=""></td><td><strong><%=p.nome%></strong></td><td><%=p.especie%></td><td><%=p.raca||'-'%></td><td><%=p.tutor_nome%></td><td><div class="row-actions"><a href="/pets/editar/<%=p.id%>" class="btn btn-edit">✎ Editar</a><form method="post" action="/pets/excluir/<%=p.id%>" onsubmit="return confirm('Confirma a exclusão deste registro?')"><input type="hidden" name="_csrf" value="<%=csrf%>"><button type="submit" class="btn btn-delete">Excluir</button></form></div></td></tr><%})%></tbody></table></div></section><%-include('../includes/footer')%>