<%-include('../includes/header')%><div class="page-heading"><div><span class="eyebrow">CADASTROS</span><h1>Pets</h1><p>Informações dos animais e tutores.</p></div><a href="/pets/novo" class="btn">＋ Novo pet</a></div><section class="panel"><form method="get" class="listing-filters"><label class="filter-search">Pesquisar<input name="busca" value="<%=busca%>" placeholder="Pesquisar registros"></label><label>Espécie<select name="filtro"><option value="">Todas</option><option value="Cachorro" <%=filtro==='Cachorro'?'selected':''%>>Cachorro</option><option value="Gato" <%=filtro==='Gato'?'selected':''%>>Gato</option><option value="Outros" <%=filtro==='Outros'?'selected':''%>>Outros</option></select></label><label>Ordenação<select name="ordem"><option value="nome" <%=ordem==='nome'?'selected':''%>>Nome A-Z</option><option value="nome_desc" <%=ordem==='nome_desc'?'selected':''%>>Nome Z-A</option><option value="especie" <%=ordem==='especie'?'selected':''%>>Espécie</option><option value="tutor" <%=ordem==='tutor'?'selected':''%>>Tutor</option><option value="id_desc" <%=ordem==='id_desc'?'selected':''%>>Mais recentes</option></select></label><button class="btn">Filtrar</button><a class="btn btn-secondary" href="/pets">Limpar</a></form><div class="table table-scroll table-pets" tabindex="0" aria-label="Tabela de pets; role para os lados quando necessário"><table><thead><tr><th>Foto</th><th>Pet</th><th>Espécie</th><th>Raça</th><th>Tutor</th><th>Ações</th></tr></thead><tbody><%registros.forEach(p=>{%><tr><td><img class="pet-thumb" src="<%=p.imagem_url?'/img/pets/'+p.imagem_url:'/img/pets/sem-foto.svg'%>" alt=""></td><td><strong><%=p.nome%></strong></td><td><%=p.especie%></td><td><%=p.raca||'-'%></td><td><%=p.tutor_nome%></td><td><div class="row-actions"><a href="/pets/editar/<%=p.id%>" class="btn btn-edit">✎ Editar</a><form method="post" action="/pets/excluir/<%=p.id%>" onsubmit="return confirm('Confirma a exclusão deste registro?')"><button type="submit" class="btn btn-delete">Excluir</button></form></div></td></tr><%})%></tbody></table></div><%-include('../includes/paginacao')%></section><%-include('../includes/footer')%>