<%-include('../includes/header')%><div class="page-title"><div><h1>Pets</h1><p>Consulte e gerencie os animais cadastrados.</p></div><a class="btn" href="/pets/novo">Novo pet</a></div><div class="card table"><table><thead><tr><th>Foto</th><th>Pet</th><th>Espécie</th><th>Raça</th><th>Tutor</th><th>Ações</th></tr></thead><tbody><%registros.forEach(p=>{%><tr><td><img class="pet-thumb" src="<%=p.imagem_url?'/img/pets/'+p.imagem_url:'/img/pets/sem-foto.svg'%>" alt="Foto do pet <%=p.nome%>"></td><td><strong><%=p.nome%></strong></td><td><%=p.especie%></td><td><%=p.raca||'-'%></td><td><%=p.tutor_nome%></td><td><a class="btn btn-sm btn-secundario" href="/pets/editar/<%=p.id%>">Editar</a></td></tr><%})%></tbody></table></div><%-include('../includes/footer')%>